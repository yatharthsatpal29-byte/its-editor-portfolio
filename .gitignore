@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap');

:root {
  --bg: #f7f5f2;
  --panel: #ffffff;
  --panel-soft: #f2f1ee;
  --muted: #6f6a63;
  --text: #121212;
  --line: rgba(18, 18, 18, 0.09);
  --line-strong: rgba(18, 18, 18, 0.12);
  --shadow: 0 20px 45px rgba(20, 18, 15, 0.07);
  --shadow-soft: 0 10px 22px rgba(20, 18, 15, 0.05);
  --accent: #c7775b;
  --accent-deep: #a6573c;
  --accent-soft: rgba(199, 119, 91, 0.12);
  --radius-lg: 22px;
  --radius-md: 16px;
  --radius-sm: 12px;
  --container: 1200px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: 'Inter', sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

#root {
  min-height: 100vh;
}

.page-shell {
  min-height: 100vh;
}

.container {
  width: min(var(--container), calc(100% - 32px));
  margin: 0 auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 30;
  background: rgba(247, 245, 242, 0.78);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--line);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 82px;
  gap: 24px;
}

.brand,
.footer-brand {
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700;
  letter-spacing: -0.05em;
  font-size: clamp(1.2rem, 2vw, 1.7rem);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 32px;
}

.nav-links a {
  color: var(--text);
  font-weight: 500;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.nav-links a:hover,
.nav-links a:focus-visible {
  opacity: 0.8;
  transform: translateY(-1px);
}

.instagram-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 0.8rem 1.15rem;
  background: rgba(18, 18, 18, 0.04);
  border: 1px solid var(--line-strong);
}

.menu-toggle {
  display: none;
  background: transparent;
  border: 1px solid var(--line-strong);
  width: 48px;
  height: 48px;
  border-radius: 12px;
  padding: 0.8rem 0.7rem;
}

.menu-toggle span {
  display: block;
  width: 100%;
  height: 2px;
  background: var(--text);
  border-radius: 99px;
  margin: 4px 0;
}

.hero {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  align-items: center;
  gap: 48px;
  padding: 72px 0 52px;
}

.eyebrow {
  margin: 0 0 16px;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--muted);
  font-weight: 700;
}

.hero h1,
.section-header h2,
.featured-copy h2,
.instagram-cta h2 {
  margin: 0;
  font-family: 'Space Grotesk', sans-serif;
  letter-spacing: -0.06em;
  line-height: 0.96;
}

.hero h1 {
  font-size: clamp(3.2rem, 7vw, 6rem);
  max-width: 620px;
}

.subtitle {
  font-size: clamp(1.1rem, 2vw, 1.55rem);
  color: var(--muted);
  margin: 24px 0 0;
  max-width: 520px;
}

.hero-actions,
.feature-actions,
.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 32px;
}

.button,
.card-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  font-weight: 600;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.button:hover,
.card-button:hover,
.filter:hover,
.watch-pill:hover {
  transform: translateY(-1px);
}

.button.primary,
.card-button.primary,
.watch-pill {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 12px 28px rgba(199, 119, 91, 0.25);
}

.button.primary:hover,
.card-button.primary:hover,
.watch-pill:hover {
  background: var(--accent-deep);
}

.button,
.card-button {
  padding: 0.96rem 1.5rem;
  min-height: 52px;
}

.button.secondary,
.card-button.secondary {
  background: rgba(18, 18, 18, 0.04);
  border: 1px solid var(--line-strong);
  color: var(--text);
}

.hero-visual {
  position: relative;
}

.preview-frame,
.featured-frame {
  position: relative;
  overflow: hidden;
  border-radius: 30px;
  background-size: cover;
  background-position: center;
  box-shadow: var(--shadow);
  border: 1px solid rgba(18, 18, 18, 0.06);
}

.preview-frame {
  height: 620px;
  background-image: linear-gradient(135deg, rgba(17, 15, 15, 0.12), rgba(17, 15, 15, 0.4)),
    url('https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=80');
}

.preview-badge,
.featured-badge {
  position: absolute;
  top: 22px;
  left: 22px;
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.85);
  color: var(--text);
  border: 1px solid rgba(18, 18, 18, 0.08);
  border-radius: 999px;
  padding: 0.6rem 0.9rem;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  backdrop-filter: blur(10px);
}

.preview-meta {
  position: absolute;
  left: 24px;
  right: 24px;
  bottom: 24px;
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.preview-meta span {
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(18, 18, 18, 0.08);
  color: var(--text);
  border-radius: 999px;
  padding: 0.5rem 0.8rem;
  font-size: 0.72rem;
  font-weight: 700;
}

.play-btn {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 80px;
  height: 80px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: rgba(255, 255, 255, 0.8);
  color: var(--text);
  border: 1px solid rgba(18, 18, 18, 0.1);
  font-size: 2rem;
  box-shadow: var(--shadow-soft);
}

.play-btn.large {
  width: 96px;
  height: 96px;
  font-size: 2.4rem;
}

.edit-section,
.downloads-section,
.about-section,
.instagram-cta {
  padding: 60px 0 0;
}

.section-header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 26px;
}

.section-header h2,
.featured-copy h2,
.instagram-cta h2 {
  font-size: clamp(2.2rem, 4vw, 3.5rem);
}

.toolbar {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.filter {
  border: 1px solid var(--line-strong);
  background: rgba(18, 18, 18, 0.02);
  color: var(--text);
  border-radius: 999px;
  height: 42px;
  padding: 0 1rem;
  font-weight: 600;
  transition: all 0.2s ease;
}

.filter.active {
  background: var(--text);
  color: white;
  border-color: var(--text);
}

.search-box {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(18, 18, 18, 0.02);
  border: 1px solid var(--line-strong);
  border-radius: 999px;
  min-width: min(100%, 320px);
  height: 48px;
  padding: 0 16px;
}

.search-icon {
  color: var(--muted);
  font-size: 1.3rem;
}

.search-box input {
  width: 100%;
  border: 0;
  outline: none;
  background: transparent;
  color: var(--text);
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.edit-card,
.download-card {
  display: flex;
  flex-direction: column;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-soft);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.edit-card:hover,
.download-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow);
}

.thumb {
  position: relative;
  min-height: 260px;
  background-size: cover;
  background-position: center;
  border-bottom: 1px solid var(--line);
}

.duration {
  position: absolute;
  bottom: 14px;
  left: 14px;
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(18, 18, 18, 0.08);
  color: var(--text);
  border-radius: 999px;
  padding: 0.45rem 0.65rem;
  font-size: 0.72rem;
  font-weight: 700;
}

.watch-pill {
  position: absolute;
  right: 14px;
  bottom: 14px;
  border: 0;
  color: white;
  border-radius: 999px;
  padding: 0.66rem 1rem;
  font-weight: 700;
}

.card-body {
  padding: 20px 20px 18px;
}

.meta-row {
  margin-bottom: 12px;
}

.category-tag {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent-deep);
  border: 1px solid rgba(167, 90, 60, 0.12);
  padding: 0.42rem 0.7rem;
  font-size: 0.72rem;
  font-weight: 700;
}

.card-body h3,
.download-head h3 {
  margin: 0 0 10px;
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(1.35rem, 2vw, 1.7rem);
  letter-spacing: -0.04em;
}

.card-body p {
  margin: 0;
  color: var(--muted);
  font-size: 0.96rem;
}

.card-actions {
  margin-top: 20px;
}

.card-button,
.button {
  min-width: 120px;
}

.full {
  width: 100%;
}

.loading-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.skeleton-card {
  height: 360px;
  background: linear-gradient(90deg, rgba(18, 18, 18, 0.04), rgba(18, 18, 18, 0.08), rgba(18, 18, 18, 0.04));
  background-size: 200% 100%;
  animation: skeleton 1.2s ease-in-out infinite;
  border-radius: var(--radius-lg);
}

@keyframes skeleton {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.empty-state {
  background: rgba(18, 18, 18, 0.02);
  border: 1px dashed var(--line-strong);
  border-radius: var(--radius-lg);
  text-align: center;
  padding: 54px 20px;
}

.empty-state h3 {
  margin: 0 0 10px;
  font-size: clamp(1.4rem, 2vw, 1.8rem);
  font-family: 'Space Grotesk', sans-serif;
}

.empty-state p {
  margin: 0;
  color: var(--muted);
}

.featured {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 42px;
  align-items: center;
  padding-top: 80px;
}

.featured-frame {
  height: 620px;
  background-size: cover;
  background-position: center;
  border-radius: 30px;
}

.featured-copy {
  padding: 10px 0;
}

.featured-description {
  margin: 18px 0 0;
  font-size: 1.08rem;
  color: var(--muted);
  max-width: 500px;
}

.featured-meta,
.download-specs,
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.featured-meta {
  margin-top: 24px;
}

.featured-meta span,
.tag,
.download-specs span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: rgba(18, 18, 18, 0.04);
  border: 1px solid var(--line-strong);
  padding: 0.52rem 0.8rem;
  font-size: 0.8rem;
  font-weight: 600;
}

.tag-list {
  margin-top: 18px;
}

.tag {
  background: rgba(199, 119, 91, 0.08);
  color: var(--accent-deep);
  border-color: rgba(167, 90, 60, 0.1);
}

.downloads-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
  margin-top: 28px;
}

.download-card {
  flex-direction: row;
  min-height: 260px;
}

.download-thumb {
  width: 40%;
  min-height: 100%;
  background-size: cover;
  background-position: center;
  border-right: 1px solid var(--line);
}

.download-details {
  flex: 1;
  padding: 20px;
}

.download-head {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: center;
  margin-bottom: 16px;
}

.download-specs {
  margin-bottom: 16px;
}

.usage-info {
  margin: 0 0 18px;
  color: var(--muted);
}

.about-copy {
  margin: 0 auto;
  max-width: 820px;
  font-size: clamp(1.1rem, 2vw, 1.5rem);
  color: var(--muted);
  text-align: center;
}

.instagram-cta {
  padding-bottom: 72px;
}

.cta-box {
  background: linear-gradient(135deg, rgba(255,255,255,0.96), rgba(242,241,238,0.96));
  border: 1px solid var(--line);
  border-radius: 30px;
  box-shadow: var(--shadow-soft);
  text-align: center;
  padding: 54px 20px;
}

.cta-box p {
  margin: 0 auto;
  max-width: 560px;
  color: var(--muted);
  font-size: 1.08rem;
}

.cta-handle {
  margin: 20px 0 28px;
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700;
  font-size: clamp(1.3rem, 2vw, 2rem);
  letter-spacing: -0.04em;
}

.site-footer {
  border-top: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.6);
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  min-height: 120px;
}

.footer-brand {
  margin-bottom: 8px;
}

.footer-inner p,
.footer-social {
  margin: 0;
  color: var(--muted);
}

.footer-social {
  display: flex;
  align-items: center;
  gap: 10px;
}

.footer-social a {
  color: var(--text);
  font-weight: 600;
}

.downloads-description {
  margin: 0;
  color: var(--muted);
  max-width: 700px;
  font-size: 1.04rem;
}

.narrow {
  justify-content: center;
}

@media (max-width: 960px) {
  .hero,
  .featured,
  .card-grid,
  .downloads-grid {
    grid-template-columns: 1fr;
  }

  .card-grid,
  .downloads-grid {
    display: grid;
  }

  .download-card {
    flex-direction: column;
  }

  .download-thumb {
    width: 100%;
    min-height: 240px;
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }
}

@media (max-width: 760px) {
  .menu-toggle {
    display: block;
  }

  .nav {
    position: relative;
  }

  .nav-links {
    position: absolute;
    top: calc(100% + 12px);
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: 18px 16px 18px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: var(--shadow-soft);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .nav-links.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .nav-links a {
    width: 100%;
  }

  .instagram-link {
    width: 100%;
    justify-content: flex-start;
  }

  .brand {
    font-size: 1.28rem;
  }

  .hero {
    padding-top: 42px;
  }

  .preview-frame,
  .featured-frame {
    height: 440px;
  }

  .toolbar,
  .search-box {
    width: 100%;
  }

  .search-box {
    min-width: 100%;
  }

  .featured-meta,
  .card-actions,
  .hero-actions,
  .feature-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .button,
  .card-button {
    width: 100%;
  }

  .footer-inner {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 20px 0;
  }
}

@media (max-width: 480px) {
  .container {
    width: min(var(--container), calc(100% - 20px));
  }

  .nav {
    height: 74px;
  }

  .hero h1 {
    font-size: 2.7rem;
  }

  .section-header h2,
  .featured-copy h2,
  .instagram-cta h2 {
    font-size: 2.2rem;
  }

  .card-grid {
    grid-template-columns: 1fr;
  }

  .edit-card {
    min-width: 0;
  }

  .thumb {
    min-height: 220px;
  }
}
